# ─────────────────────────────────────────────────────────────
# Variables de entorno del BACKEND
# 1. Copia este archivo y renómbralo como .env   (cp .env.example .env)
# 2. Ajusta los valores. El archivo .env NUNCA se sube a Git.
# ─────────────────────────────────────────────────────────────

# Puerto donde escucha la API
PORT=3000

# Clave para firmar los tokens JWT (una cadena larga y aleatoria) y su duración
JWT_SECRET=cambia-esta-clave-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=1d

# Origen(es) del frontend autorizados por CORS (separa varios con coma)
CORS_ORIGIN=http://localhost:5173

# Contraseñas de las cuentas de prueba que se cargan al iniciar el servidor
SEED_ADMIN_PASSWORD=Admin12345
SEED_USER_PASSWORD=Usuario12345
