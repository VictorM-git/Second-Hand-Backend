# Copia este archivo como .env y completa los valores. El .env NO se sube al repositorio.

# Puerto del servidor
PORT=3000

# Clave para firmar los tokens JWT (una cadena larga y aleatoria) y su duración
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES_IN=1d

# Frontend autorizado por CORS (varios separados por coma)
CORS_ORIGIN=http://localhost:5173

# Contraseñas de las cuentas de prueba que se cargan al iniciar el servidor
SEED_ADMIN_PASSWORD=Admin12345
SEED_USER_PASSWORD=Usuario12345
