# ═════════════════════════════════════════════════════════════════
# REFERENCIA de todas las variables de entorno del proyecto.
# Este archivo NO se usa directamente: cada proyecto lee su propio .env
#
#   backend/.env   ← copia de backend/.env.example
#   frontend/.env  ← copia de frontend/.env.example
#
# Nunca subas los archivos .env a Git (ya están en .gitignore).
# ═════════════════════════════════════════════════════════════════

# ─── backend/.env ─────────────────────────────────────────────────
PORT=3000
JWT_SECRET=cambia-esta-clave-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173
SEED_ADMIN_PASSWORD=Admin12345
SEED_USER_PASSWORD=Usuario12345

# ─── frontend/.env ────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api
